{
  "name": "elonmusksucks",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "engineStrict": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "bash scripts/cleanup-ports.sh",
    "dev": "concurrently \"npm run dev --workspace=apps/client\" \"npm run dev --workspace=apps/public-site\" \"npm run dev --workspace=apps/server\" \"npm run worker\" \"npm run dev --workspace=apps/pong-server\"",
    "dev:with-pong": "concurrently \"npm run dev --workspace=apps/client\" \"npm run dev --workspace=apps/server\" \"npm run worker\" \"npm run dev --workspace=apps/pong-server\" \"npm run pong:worker\"",
    "cleanup": "bash scripts/cleanup-ports.sh",
    "build": "npm run prisma:generate && cd packages/types && npm run build && cd ../../ && npm run build --workspace=apps/client && npm run build --workspace=apps/server",
    "lint": "eslint apps/**/*.{ts,tsx} --max-warnings=0",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "setup": "npm install && npm run prisma:generate && cd packages/types && npm run build && cd ../../apps/server && npm install && npm run prisma:migrate:dev && npm run seed:dev",
    "prisma:generate": "dotenv -e .env -- prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:dev": "dotenv -e .env -- prisma migrate reset --force --skip-generate --schema prisma/schema.prisma",
    "seed:dev": "tsx prisma/seed.ts",
    "seed:prod": "ts-node --transpile-only scripts/prod-seed.ts",
    "seed:achievements": "node scripts/seed-achievements.cjs",
    "seed:categories": "tsx prisma/seeds/categories.seed.ts",
    "test": "jest",
    "test:server": "dotenv -e .env.test jest --selectProjects=server",
    "worker": "npm run worker --workspace=apps/server",
    "pong": "npm run dev --workspace=apps/pong-server",
    "pong:worker": "npm run worker --workspace=apps/pong-server"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "axios": "^1.11.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "prisma": "^6.16.3",
    "supertest": "^7.1.3",
    "testcontainers": "^11.2.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "lightningcss": "^1.30.1",
    "recharts": "^3.1.0",
    "typescript": "^5.9.2"
  }
}
