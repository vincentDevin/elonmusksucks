# ══════════════════════════════════════════════════════════════════════════════
# Client Application Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
# IMPORTANT: All client environment variables MUST be prefixed with VITE_
# to be exposed to the client bundle. Variables without VITE_ prefix will
# NOT be available in the client code.
# ══════════════════════════════════════════════════════════════════════════════

# ─── API CONFIGURATION ───────────────────────────────────────────────────────
# IMPORTANT: These variables behave differently in development vs production

# API Base URL
# Development: LEAVE EMPTY or OMIT - Vite proxy will handle API requests
#              (localhost:3000/api/* → localhost:5000/api/*)
# Production: REQUIRED - Full API URL (e.g., https://api.elonmusksucks.net)
VITE_API_BASE_URL=

# Socket.IO URL
# Development: LEAVE EMPTY or OMIT - Vite proxy will handle socket connection
#              (localhost:3000/socket.io → localhost:5000/socket.io)
# Production: REQUIRED - Full API URL (e.g., https://api.elonmusksucks.net)
VITE_SOCKET_URL=

# Public Site URL (for redirects when user is not authenticated)
# Development: http://localhost:5173 (or OMIT to use default)
# Production: REQUIRED - Full public site URL
VITE_PUBLIC_SITE_URL=

# ─── FEATURE FLAGS (OPTIONAL) ────────────────────────────────────────────────
# Enable/disable beta features
# Set to 'true' to enable, 'false' or omit to disable

# Enable Pong beta features
VITE_FEATURE_PONG_BETA=false

# Enable enhanced chat features
VITE_FEATURE_ENHANCED_CHAT=false

# Enable advanced analytics dashboard
VITE_FEATURE_ADVANCED_ANALYTICS=false

# Enable experimental UI components
VITE_FEATURE_EXPERIMENTAL_UI=false

# ══════════════════════════════════════════════════════════════════════════════
# DEVELOPMENT CONFIGURATION EXAMPLE
# ══════════════════════════════════════════════════════════════════════════════
# For local development, you typically want:
#
# VITE_API_BASE_URL=                    # Empty - uses Vite proxy
# VITE_SOCKET_URL=                      # Empty - uses Vite proxy
# VITE_PUBLIC_SITE_URL=                 # Empty - uses default localhost:5173
# VITE_FEATURE_PONG_BETA=true           # Enable any features you're testing
#
# The Vite dev server (localhost:3000) will proxy requests:
# - /api/* → http://localhost:5000/api/*
# - /socket.io → http://localhost:5000/socket.io
# ══════════════════════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════════════════════
# PRODUCTION CONFIGURATION EXAMPLE
# ══════════════════════════════════════════════════════════════════════════════
# For production deployment, you MUST set:
#
# VITE_API_BASE_URL=https://api.elonmusksucks.net
# VITE_SOCKET_URL=https://api.elonmusksucks.net
# VITE_PUBLIC_SITE_URL=https://public.elonmusksucks.net
# VITE_FEATURE_PONG_BETA=false          # Disable beta features in production
#
# SECURITY CHECKLIST:
# [ ] All URLs use HTTPS (https://)
# [ ] No localhost URLs in production
# [ ] Beta features disabled (unless intentionally enabled)
# [ ] Source maps disabled in production build (vite.config.ts)
# [ ] Console statements removed from production build (vite.config.ts)
# ══════════════════════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════════════════════
# TESTING PRODUCTION BUILD LOCALLY
# ══════════════════════════════════════════════════════════════════════════════
# To test a production build locally:
#
# 1. Create .env.production.local:
#    VITE_API_BASE_URL=http://localhost:5000
#    VITE_SOCKET_URL=http://localhost:5000
#    VITE_PUBLIC_SITE_URL=http://localhost:5173
#
# 2. Build and preview:
#    npm run build
#    npm run preview
#
# 3. Verify:
#    - No source maps in dist/assets/*.js.map
#    - No console statements in bundles
#    - CSP working correctly
#    - Authentication working
# ══════════════════════════════════════════════════════════════════════════════
