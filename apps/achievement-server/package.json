{
  "name": "achievement-server",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"ts-node src/index.ts\"",
    "build": "tsc -p tsconfig.json --listEmittedFiles --diagnostics",
    "start": "node dist/index.js",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate --schema ../../prisma/schema.prisma"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "ioredis": "^5.6.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@prisma/client": "^6.10.1",
    "@types/node": "^22.15.31",
    "dotenv-cli": "^8.0.0",
    "nodemon": "^3.1.10",
    "prisma": "^6.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
