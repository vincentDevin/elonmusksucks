generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum PredictionType {
  MULTIPLE
  BINARY
  OVER_UNDER
}

enum BetOption {
  YES
  NO
  OVER
  UNDER
}

enum BetStatus {
  PENDING
  WON
  LOST
  REFUNDED
}

enum TransactionType {
  DEBIT
  CREDIT
}


enum BanType {
  TEMPORARY
  PERMANENT
}

enum ModerationAction {
  USER_BAN
  USER_UNBAN
  USER_MUTE
  USER_UNMUTE
  MESSAGE_DELETE
  POST_DELETE
  USER_KICK
}

enum PostContentType {
  TEXT
  IMAGE
  LINK
  PREDICTION_SHARE
  POLL
}

enum PostVisibility {
  PUBLIC
  PRIVATE
  FOLLOWERS
  MENTIONED_ONLY
}

enum ReactionType {
  LIKE
  LOVE
  LAUGH
  WOW
  SAD
  ANGRY
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  MISINFORMATION
  INAPPROPRIATE_CONTENT
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  ACTIONED
  DISMISSED
}

model User {
  id                 Int                 @id @default(autoincrement())
  email              String              @unique
  name               String
  passwordHash       String
  emailVerified      Boolean             @default(false)
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  profileComplete    Boolean             @default(false)
  role               Role                @default(USER)
  active             Boolean             @default(true)
  muskBucks          BigInt              @default(1000) // Rollback: remove @@map constraint reference
  isSystemAccount    Boolean             @default(false)
  bets               Bet[]
  refreshTokens      RefreshToken[]
  userBadges         UserBadge[]         @relation("UserToUserBadge")
  followers          Follow[]            @relation("userFollowers")
  following          Follow[]            @relation("userFollowing")
  bio                String? // optional user bio
  avatarUrl          String? // URL to profile image
  profilePictureKey    String?
  location           String? // user-provided location
  timezone           String? // IANA timezone string
  // statistics (can be updated via triggers or backend logic)
  successRate        Float               @default(0.0)
  totalPredictions   Int                 @default(0)
  currentStreak      Int                 @default(0)
  longestStreak      Int                 @default(0)
  // user settings
  notifyOnResolve    Boolean             @default(true)
  theme              String              @default("light-clean")  // Unified theme system ID
  twoFactorEnabled   Boolean             @default(false)
  createdAt          DateTime            @default(now())
  parlayes           Parlay[]
  transactions       Transaction[]
  feedPrivate        Boolean             @default(false)
  posts              UserPost[]          @relation("AuthorToPost")
  postReactions      PostReaction[]
  postReports        PostReport[]
  postMentions       PostMention[]
  activities         UserActivity[]
  activityLogs       UserActivityLog[]
  streaks            UserStreak[]
  emojiUsage         UserEmojiUsage[]
  leaderboardHistory LeaderboardHistory[]
  relatedActivities  UserActivity[] @relation("RelatedUserActivity")
  achievements       UserAchievement[]
  stats              UserStats?
  Prediction         Prediction[]
  firstCorrectBets   Prediction[] @relation("FirstCorrectBet")
  messages           Message[]
  bans               UserBan[]
  moderationActions  ModerationLog[] @relation("ModeratorActions")
  moderationReceived ModerationLog[] @relation("ModeratedUser")
  articleReactions   ArticleReaction[]
  articleComments    ArticleComment[]
  // Pong relations
  pongMatchesAsP1    PongMatch[]     @relation("PlayerOne")
  pongMatchesAsP2    PongMatch[]     @relation("PlayerTwo")
  pongWins           PongMatch[]     @relation("PongWinner")
  pongMatchesAsHost  PongMatch[]     @relation("PongHost")
  pongMatchesAsJoiner PongMatch[]    @relation("PongJoiner")
  pongMatchesAsAI    PongMatch[]     @relation("PongAI")
  pongStats          PongStats?
}

model ChatRoom {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  messages Message[]
}

model Message {
  id         Int      @id @default(autoincrement())
  roomId     Int
  userId     Int
  content    String
  timestamp  DateTime @default(now())
  // Relations
  user       User     @relation(fields: [userId], references: [id])
  room       ChatRoom @relation(fields: [roomId], references: [id])
}

model EmailVerification {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Prediction {
  id              Int                @id @default(autoincrement())
  title           String
  description     String
  category        String
  type            PredictionType     @default(MULTIPLE)
  threshold       Float?
  expiresAt       DateTime
  resolved        Boolean            @default(false)
  approved        Boolean            @default(false)
  resolvedAt          DateTime?
  winningOptionId     Int?
  viewCount           Int       @default(0)
  firstCorrectBetUserId Int?
  firstCorrectBetUser User?     @relation("FirstCorrectBet", fields: [firstCorrectBetUserId], references: [id])
  resolvedWithinHour  Boolean   @default(false)
  bets                Bet[]
  options         PredictionOption[]
  createdAt       DateTime           @default(now())
  creatorId       Int
  creator         User                   @relation(fields: [creatorId], references: [id])
  activities      UserActivity[]
  sourceLinks     PredictionSourceLink[]

  @@index([expiresAt, resolved])
  @@index([creatorId, createdAt(sort: Desc)])
  @@index([category, createdAt(sort: Desc)])
  @@index([approved, resolved, createdAt(sort: Desc)])
  @@index([viewCount(sort: Desc)], name: "idx_prediction_popularity")
  @@index([firstCorrectBetUserId], name: "idx_prediction_first_correct")
  @@index([resolvedWithinHour, resolvedAt], name: "idx_prediction_speed")
  @@index([category, approved])
}

model PredictionOption {
  id           Int         @id @default(autoincrement())
  label        String
  odds         Float // decimal odds for this option
  prediction   Prediction  @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  predictionId Int
  bets         Bet[]       @relation("OptionToBet")
  createdAt    DateTime    @default(now())
  parlayLegs   ParlayLeg[]
}

model Bet {
  id              Int               @id @default(autoincrement())
  user            User              @relation(fields: [userId], references: [id])
  userId          Int
  prediction      Prediction        @relation(fields: [predictionId], references: [id])
  predictionId    Int
  amount          BigInt
  oddsAtPlacement Float? // snapshot of odds when placing the bet; Rollback: remove constraint reference
  potentialPayout BigInt? // computed at placement: amount * oddsAtPlacement
  status          BetStatus         @default(PENDING)
  // Rollback: Remove onDelete: SetNull from the relation
  optionOption    PredictionOption? @relation("OptionToBet", fields: [optionId], references: [id], onDelete: SetNull)
  optionId        Int?
  won             Boolean? // null until resolved
  payout          BigInt? // null until resolved
  createdAt       DateTime          @default(now())
  activities      UserActivity[]
  // Rollback: Remove idempotencyKey field and unique constraint
  idempotencyKey  String?           @unique // Client-provided key to prevent duplicate bets

  @@index([userId, createdAt(sort: Desc)])
  @@index([predictionId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([userId, predictionId, createdAt(sort: Desc)])
  // Rollback: Remove this index
  @@index([userId, status, createdAt(sort: Desc)]) // Optimize user bet history queries with status filter
}

model AITweet {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  expiresAt DateTime
}

model LeaderboardEntry {
  userId    Int     @id @map("user_id")
  userName  String  @map("user_name")
  avatarUrl String? @map("avatar_url")
  balance   BigInt  @map("balance")

  totalBets    Int     @map("total_bets")
  winRate      Float   @map("win_rate")
  profitAll    BigInt  @map("profit_all")
  profitPeriod BigInt  @map("profit_period")
  roi          Float @map("roi")

  longestStreak Int @map("longest_streak")
  currentStreak Int @map("current_streak")

  parlaysStarted Int @map("parlays_started")
  parlaysWon     Int @map("parlays_won")

  totalParlayLegs Int @map("total_parlay_legs")
  parlayLegsWon   Int @map("parlay_legs_won")

  rankChange Int? @map("rank_change")

  @@map("leaderboard_view")
}

model Badge {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  description String?
  iconUrl     String?
  users       UserBadge[] @relation("BadgeToUserBadge")
  createdAt   DateTime    @default(now())
}

model Achievement {
  id                    Int                 @id @default(autoincrement())
  name                  String              @unique
  slug                  String?             @unique // Kebab-case unique identifier for seeds/lookups
  title                 String              // Display title
  description           String              // Achievement description
  category              String              // Category: betting, prediction, chat, leaderboard, event, secret, participation, shame
  rarity                String              @default("common") // common, uncommon, rare, legendary, secret, shame
  targetValue           Int                 // Target value to achieve (e.g., 10 for "Win 10 bets")
  iconUrl               String?             // Icon URL for display
  isActive              Boolean             @default(true) // Whether this achievement is currently active
  autoAward             Boolean             @default(true) // Whether this achievement is auto-awarded via triggers
  manualOnly            Boolean             @default(false) // Whether this achievement can only be manually granted
  isShame               Boolean             @default(false) // Whether this is a shame achievement for banned users
  sortOrder             Int                 @default(0) // Display order
  ruleData              Json?               // JSON rules for event-driven achievement evaluation
  ruleComplexity        Int                 @default(0) // Rule complexity score (0-100)
  rulePerformanceScore  Int                 @default(0) // Rule performance score (0-100)
  lastRuleValidation    DateTime?           // Last time rule was validated
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @default(now()) @updatedAt
  
  // Relations
  userProgress  UserAchievement[]
  
  @@index([category, sortOrder])
  @@index([isActive, category])
  @@index([rarity])
  @@index([autoAward])
  @@index([isShame])
  @@index([category, rarity])
  @@index([ruleComplexity])
  @@index([rulePerformanceScore])
  @@index([lastRuleValidation])
  @@index([ruleComplexity, rulePerformanceScore])
}

model UserAchievement {
  id            Int         @id @default(autoincrement())
  user          User        @relation(fields: [userId], references: [id])
  userId        Int
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  achievementId Int
  progress      Int         @default(0) // Current progress towards target
  completedAt   DateTime?   // When achievement was completed (null if not completed)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  
  @@unique([userId, achievementId])
  @@index([userId, progress])
  @@index([achievementId, completedAt])
}

model AchievementEventLog {
  idempotencyKey String   @id // Unique per event to prevent duplicates
  userId         Int
  eventKey       String   // Achievement event type
  createdAt      DateTime @default(now())
  
  @@index([userId, eventKey])
  @@index([createdAt])
}

model UserBadge {
  id        Int      @id @default(autoincrement())
  user      User     @relation("UserToUserBadge", fields: [userId], references: [id])
  userId    Int
  badge     Badge    @relation("BadgeToUserBadge", fields: [badgeId], references: [id])
  badgeId   Int
  awardedAt DateTime @default(now())
  reason    String?

  @@unique([userId, badgeId])
}

model Follow {
  id          Int      @id @default(autoincrement())
  follower    User     @relation("userFollowing", fields: [followerId], references: [id])
  followerId  Int
  following   User     @relation("userFollowers", fields: [followingId], references: [id])
  followingId Int
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model Parlay {
  id              Int         @id @default(autoincrement())
  user            User        @relation(fields: [userId], references: [id])
  userId          Int
  amount          BigInt
  combinedOdds    Float
  potentialPayout BigInt
  status          BetStatus   @default(PENDING)
  legs            ParlayLeg[]
  createdAt       DateTime    @default(now())
  // Rollback: Remove idempotencyKey field and unique constraint
  idempotencyKey  String?     @unique // Client-provided key to prevent duplicate parlays

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model ParlayLeg {
  id              Int              @id @default(autoincrement())
  parlay          Parlay           @relation(fields: [parlayId], references: [id], onDelete: Cascade)
  parlayId        Int
  option          PredictionOption @relation(fields: [optionId], references: [id])
  optionId        Int
  oddsAtPlacement Float
  createdAt       DateTime         @default(now())
}

model Transaction {
  id              Int             @id @default(autoincrement())
  user            User            @relation(fields: [userId], references: [id])
  userId          Int
  type            TransactionType
  amount          BigInt
  balanceAfter    BigInt
  relatedBetId    Int? // single bet
  relatedParlayId Int? // parlay bet
  createdAt       DateTime        @default(now())
  // Pong relations
  pongEscrowMatches PongMatch[]    @relation("PongEscrowTransaction")
  pongPayoutMatches PongMatch[]    @relation("PongPayoutTransaction")
  // Rollback: Remove idempotencyKey field and unique constraint
  idempotencyKey  String?         @unique // Client-provided key to prevent duplicate transactions

  @@index([userId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@index([relatedBetId])
  @@index([relatedParlayId])
}

model UserPost {
  id            Int                @id @default(autoincrement())
  author        User               @relation("AuthorToPost", fields: [authorId], references: [id])
  authorId      Int
  
  // Content
  content       String             @db.Text
  contentType   PostContentType    @default(TEXT)
  mediaUrls     Json?              // Array of media URLs
  linkPreview   Json?              // OG tags for link previews
  
  // Privacy & Visibility
  visibility    PostVisibility     @default(PUBLIC)
  isDeleted     Boolean            @default(false)
  deletedAt     DateTime?
  deletedBy     Int?               // User ID who deleted (author or admin)
  
  // Engagement Metrics
  likesCount    Int                @default(0)
  commentsCount Int                @default(0)
  sharesCount   Int                @default(0)
  viewsCount    BigInt             @default(0)
  
  // Threading
  parent        UserPost?          @relation("PostParent", fields: [parentId], references: [id])
  parentId      Int?
  children      UserPost[]         @relation("PostParent")
  threadDepth   Int                @default(0)
  
  // Moderation
  reportCount   Int                @default(0)
  isFlagged     Boolean            @default(false)
  moderationNote String?
  
  // Timestamps
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  editedAt      DateTime?
  
  // Relations
  reactions     PostReaction[]
  reports       PostReport[]
  mentions      PostMention[]
  hashtags      PostHashtag[]
  
  @@index([authorId, visibility, createdAt])
  @@index([visibility, createdAt])
  @@index([parentId])
}

model UserActivity {
  id               Int         @id @default(autoincrement())
  user             User        @relation(fields: [userId], references: [id])
  userId           Int
  type             String // e.g. "BET_PLACED", "BET_WON", "POST_CREATED", etc.
  title            String? // Activity title for display
  description      String? // Activity description for display
  details          Json? // Store event metadata (e.g., betId, predictionId, badgeId, postId)
  isPersonal       Boolean     @default(false) @map("is_personal") // Whether this is personal or public activity
  priority         String      @default("medium") // Priority level: low, medium, high
  relatedUserId    Int?        @map("related_user_id") // Reference to another user involved
  predictionId     Int?        @map("prediction_id") // Reference to related prediction
  betId            Int?        @map("bet_id") // Reference to related bet
  createdAt        DateTime    @default(now())
  
  // Relations
  relatedUser      User?       @relation("RelatedUserActivity", fields: [relatedUserId], references: [id])
  prediction       Prediction? @relation(fields: [predictionId], references: [id])
  bet              Bet?        @relation(fields: [betId], references: [id])
  pongMatch        PongMatch?  @relation(fields: [pongMatchId], references: [id])
  pongMatchId      String?     @map("pong_match_id")

  // Indexes for optimal query performance
  @@index([userId, createdAt(sort: Desc)], name: "idx_user_activities_user_time")
  @@index([type, priority, createdAt(sort: Desc)], name: "idx_user_activities_type_priority")
  @@index([isPersonal, createdAt(sort: Desc)], name: "idx_user_activities_public")
  @@index([relatedUserId, createdAt(sort: Desc)], name: "idx_user_activities_related_user")
  @@index([predictionId, createdAt(sort: Desc)], name: "idx_user_activities_prediction")
  @@index([betId, createdAt(sort: Desc)], name: "idx_user_activities_bet")
  // Rollback: Remove this index
  @@index([isPersonal, type, createdAt(sort: Desc)], name: "idx_user_activities_dashboard") // Optimize dashboard activity queries
}

model UserActivityLog {
  id           Int      @id @default(autoincrement())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       Int
  activityType String   @db.VarChar(50) // 'chat_message', 'bet_placed', 'login', 'pong_match', etc.
  metadata     Json?    // Additional context data for the activity
  occurredAt   DateTime @default(now())
  dateKey      String   @db.VarChar(10) // '2024-01-15' format for efficient daily aggregation

  // Optimized indexes for time-based achievement queries
  @@index([userId, dateKey, activityType], name: "idx_activity_user_date_type")
  @@index([activityType, occurredAt(sort: Desc)], name: "idx_activity_type_time")
  @@index([dateKey, activityType], name: "idx_activity_date_type")
  @@index([userId, occurredAt(sort: Desc)], name: "idx_activity_user_time")
}

model UserStreak {
  id            Int      @id @default(autoincrement())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int
  streakType    String   @db.VarChar(50) // 'bet_win', 'pong_win', 'daily_login', 'parlay_win', etc.
  currentStreak Int      @default(0)
  bestStreak    Int      @default(0)
  lastActionAt  DateTime?
  startedAt     DateTime?
  updatedAt     DateTime @default(now()) @updatedAt

  // Ensure one streak record per user per streak type
  @@unique([userId, streakType], name: "unique_user_streak_type")
  @@index([streakType, bestStreak(sort: Desc)], name: "idx_streak_type_best")
  @@index([userId, lastActionAt(sort: Desc)], name: "idx_streak_user_recent")
}

model UserEmojiUsage {
  userId     Int      
  emoji      String   @db.VarChar(10)
  useCount   Int      @default(1)
  lastUsedAt DateTime @default(now()) @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Composite primary key for user-emoji pair
  @@id([userId, emoji], name: "user_emoji_pk")
  @@index([emoji, useCount(sort: Desc)], name: "idx_emoji_popular")
  @@index([userId, lastUsedAt(sort: Desc)], name: "idx_user_emoji_recent")
  @@index([userId, useCount(sort: Desc)], name: "idx_user_emoji_frequency")
}

model LeaderboardHistory {
  id              Int      @id @default(autoincrement())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int
  leaderboardType String   @db.VarChar(20) // 'daily', 'weekly', 'monthly', 'allTime'
  position        Int
  score           BigInt   // User's score at snapshot time
  snapshotDate    DateTime @db.Date // Date of the snapshot
  metadata        Json?    // Additional context (category, etc.)
  createdAt       DateTime @default(now())

  // Unique constraint: one record per user per leaderboard type per date
  @@unique([userId, leaderboardType, snapshotDate], name: "unique_user_leaderboard_snapshot")
  @@index([leaderboardType, snapshotDate, position], name: "idx_leaderboard_ranking")
  @@index([userId, leaderboardType, snapshotDate(sort: Desc)], name: "idx_user_leaderboard_history")
  @@index([snapshotDate, leaderboardType], name: "idx_snapshot_date_type")
  @@index([position, leaderboardType], name: "idx_position_leaderboard")
}

model UserStats {
  id     Int  @id @default(autoincrement())
  user   User @relation(fields: [userId], references: [id])
  userId Int  @unique

  // single-bet metrics
  totalBets Int @default(0)
  betsWon   Int @default(0)
  betsLost  Int @default(0)

  // parlay metrics
  totalParlays    Int @default(0)
  parlaysWon      Int @default(0)
  parlaysLost     Int @default(0)
  totalParlayLegs Int @default(0)
  parlayLegsWon   Int @default(0)
  parlayLegsLost  Int @default(0)

  // combined‐order metrics
  totalWagered BigInt @default(0) // bets+parlays
  totalWon     BigInt @default(0) // sum of payouts
  profit       BigInt @default(0) // totalWon – totalWagered
  roi          Float @default(0) // profit / totalWagered
  winRate      Float @default(0) // (betsWon + parlaysWon) / (totalBets + totalParlays)

  // streak tracking
  currentStreak Int @default(0)
  longestStreak Int @default(0)

  // extras
  mostCommonBet String?
  biggestWin    BigInt  @default(0)

  updatedAt DateTime @default(now()) @updatedAt

  // Performance indexes for leaderboard queries
  @@index([totalWon(sort: Desc)])
  @@index([winRate(sort: Desc)])
  @@index([totalWagered(sort: Desc)])
}

model UserBan {
  id          Int       @id @default(autoincrement())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  banType     BanType
  reason      String
  expiresAt   DateTime? // null for permanent bans
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([userId, isActive])
  @@index([expiresAt])
}

model ModerationLog {
  id            Int              @id @default(autoincrement())
  moderator     User             @relation("ModeratorActions", fields: [moderatorId], references: [id])
  moderatorId   Int
  targetUser    User?            @relation("ModeratedUser", fields: [targetUserId], references: [id])
  targetUserId  Int?
  action        ModerationAction
  reason        String?
  details       Json? // Additional context (messageId, postId, duration, etc.)
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime         @default(now())

  @@index([moderatorId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
}

// ============================================
// Homepage Timeline Models
// ============================================

enum FeedStatus {
  ACTIVE
  PAUSED
  BLOCKED
}

enum ArticleStatus {
  PENDING
  APPROVED
  REJECTED
}

model FeedSource {
  id            Int        @id @default(autoincrement())
  name          String
  url           String     @unique
  siteUrl       String?
  status        FeedStatus @default(ACTIVE)
  allowImages   Boolean    @default(true)
  lastFetchedAt DateTime?
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  lastErrorMsg  String?
  fetchCount    Int        @default(0)
  errorCount    Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  articles      Article[]
  
  @@index([status])
  @@index([lastFetchedAt])
}

model Article {
  id                   Int                    @id @default(autoincrement())
  feedId               Int
  guid                 String?
  url                  String                 @unique
  canonicalUrl         String?
  title                String
  excerpt              String?                @db.Text
  leadImageUrl         String?
  publishedAt          DateTime?
  fetchedAt            DateTime               @default(now())
  hash                 String                 @unique
  status               ArticleStatus          @default(PENDING)
  tags                 String[]               @default([])
  modNotes             String?
  reactions            Int                    @default(0)
  comments             Int                    @default(0)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  feed                 FeedSource             @relation(fields: [feedId], references: [id], onDelete: Cascade)
  sourceLinks          PredictionSourceLink[]
  articleReactions     ArticleReaction[]
  articleComments      ArticleComment[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([hash])
  @@index([feedId])
  @@index([createdAt(sort: Desc)])
  // Rollback: Remove this covering index  
  @@index([status, feedId, publishedAt(sort: Desc)], name: "idx_articles_timeline_covering") // Covering index for timeline loads
}

model ArticleReaction {
  id        Int      @id @default(autoincrement())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  type      String   @default("like") // "like", "dislike", "love", "laugh", "angry", etc.
  createdAt DateTime @default(now())

  @@unique([articleId, userId, type])
  @@index([articleId, type])
  @@index([userId])
}

model ArticleComment {
  id        Int      @id @default(autoincrement())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId, createdAt])
  @@index([userId])
}

model Tweet {
  id                   String                 @id // Twitter snowflake ID
  postedAt             DateTime
  text                 String                 @db.Text
  permalink            String                 @unique
  authorHandle         String
  likeCount            Int                    @default(0)
  replyCount           Int                    @default(0)
  repostCount          Int                    @default(0)
  quotesCount          Int                    @default(0)
  status               String                 @default("VISIBLE")
  fetchedAt            DateTime               @default(now())
  sourceLinks          PredictionSourceLink[]

  @@index([postedAt(sort: Desc)])
  @@index([authorHandle])
  @@index([status])
}

model PredictionSourceLink {
  id           Int         @id @default(autoincrement())
  predictionId Int
  articleId    Int?
  tweetId      String?
  url          String
  title        String?
  publisher    String?
  capturedAt   DateTime    @default(now())
  prediction   Prediction  @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  article      Article?    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tweet        Tweet?      @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  
  @@index([predictionId])
  @@index([articleId])
  @@index([tweetId])
}

// ============================================
// PONG GAME MODELS - Added for Pong feature
// ============================================

enum PongMatchStatus {
  WAITING     // Waiting for opponent
  ACTIVE      // Game in progress
  COMPLETED   // Game finished normally
  ABANDONED   // Player disconnected
  DISPUTED    // Under admin review
}

enum PongDifficulty {
  EASY
  MEDIUM
  HARD
  IMPOSSIBLE
}

model PongMatch {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  status          PongMatchStatus @default(WAITING)
  
  // Players (legacy - keep for backward compatibility)
  playerOneId     Int
  playerOne       User            @relation("PlayerOne", fields: [playerOneId], references: [id])
  playerTwoId     Int?            // NULL for AI matches
  playerTwo       User?           @relation("PlayerTwo", fields: [playerTwoId], references: [id])
  aiDifficulty    PongDifficulty? // Set when playing against AI
  
  // Canonical participant fields
  mode            String          @default("PVP") // PVP or PVE_AI
  rated           Boolean         @default(false) // true if wagerAmount > 0
  hostUserId      Int?            // Made optional for migration
  hostUser        User?           @relation("PongHost", fields: [hostUserId], references: [id])
  joinerUserId    Int?           // Human joiner for PVP
  joinerUser      User?          @relation("PongJoiner", fields: [joinerUserId], references: [id])
  aiUserId        Int?           // AI opponent for PVE_AI (always -1)
  aiUser          User?          @relation("PongAI", fields: [aiUserId], references: [id])
  
  // Display name snapshots (captured at match start)
  hostDisplayName   String?
  joinerDisplayName String?
  aiDisplayName     String?       @default("Elon AI")
  
  // Wager & Economy
  wagerAmount     BigInt          @default(0) // 0 for practice matches; Rollback: remove constraint reference
  escrowTxId      Int?            // Reference to escrow transaction
  escrowTx        Transaction?    @relation("PongEscrowTransaction", fields: [escrowTxId], references: [id])
  payoutTxId      Int?            // Reference to payout transaction
  payoutTx        Transaction?    @relation("PongPayoutTransaction", fields: [payoutTxId], references: [id])
  
  // Game State
  playerOneScore  Int             @default(0)
  playerTwoScore  Int             @default(0)
  winnerId        Int?
  winner          User?           @relation("PongWinner", fields: [winnerId], references: [id])
  winningScore    Int             @default(11) // First to 11
  
  // Performance & Anti-cheat
  startedAt       DateTime?
  completedAt     DateTime?
  gameDuration    Int?            // Seconds
  tickLog         Json?           // Compressed replay data for disputes
  playerOnePing   Int             @default(0) // Average ping in ms
  playerTwoPing   Int             @default(0)
  
  // Elo Tracking per Match
  player1EloStart Int?
  player2EloStart Int?
  player1EloEnd   Int?
  player2EloEnd   Int?
  eloChange       Int?            // Absolute change amount
  skillComponent  Int?            // Skill portion of Elo change
  economyComponent Int?           // Economy portion of Elo change
  
  // Integration Points
  activities      UserActivity[]
  
  @@index([status, createdAt(sort: Desc)])
  @@index([playerOneId, status])
  @@index([playerTwoId, status])
  @@index([winnerId, completedAt(sort: Desc)])
  @@index([hostUserId])
  @@index([joinerUserId])
  @@index([mode, rated])
}

model PongStats {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id])
  
  // Hybrid Elo Rating System
  eloRating       Int      @default(1200)
  peakElo         Int      @default(1200)
  eloHistory      Json?    // Array of {date, rating, matchId, change}
  tier            String   @default("SILVER") // BRONZE|SILVER|GOLD|PLATINUM|DIAMOND|MASTER|GRANDMASTER
  
  // Elo Economy Tracking
  lastEloChange   Int      @default(0)
  totalEloGained  Int      @default(0)
  totalEloLost    Int      @default(0)
  highestWagerWin BigInt   @default(0) // Biggest single win amount
  riskTaker       Boolean  @default(false) // Flags players who bet >1k regularly
  
  // Match Statistics
  totalMatches    Int      @default(0)
  wins            Int      @default(0)
  losses          Int      @default(0)
  draws           Int      @default(0)
  winStreak       Int      @default(0)
  bestWinStreak   Int      @default(0)
  
  // Economy Statistics
  totalWagered    BigInt   @default(0)
  totalWon        BigInt   @default(0)
  totalLost       BigInt   @default(0)
  biggestWin      BigInt   @default(0)
  biggestLoss     BigInt   @default(0)
  
  // Performance Statistics
  avgPing         Float    @default(0)
  avgGameDuration Int      @default(0) // Seconds
  perfectGames    Int      @default(0) // Won 11-0
  comebacks       Int      @default(0) // Won after being down 5+ points
  
  // AI Statistics
  aiWins          Int      @default(0)
  aiLosses        Int      @default(0)
  hardestAiBeaten PongDifficulty?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([eloRating(sort: Desc)])
  @@index([tier, eloRating(sort: Desc)])
  @@index([wins(sort: Desc)])
  @@index([winStreak(sort: Desc)])
  @@index([totalWon(sort: Desc)])
  // Rollback: Remove these missing leaderboard indexes
  @@index([totalWagered(sort: Desc)]) // Optimize wager leaderboard
  @@index([perfectGames(sort: Desc)]) // Optimize perfect games leaderboard
}

model PostReaction {
  id         Int       @id @default(autoincrement())
  post       UserPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     Int
  user       User      @relation(fields: [userId], references: [id])
  userId     Int
  type       ReactionType
  createdAt  DateTime  @default(now())
  
  @@unique([postId, userId, type])
  @@index([postId])
  @@index([userId])
}

model PostReport {
  id         Int       @id @default(autoincrement())
  post       UserPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     Int
  reporter   User      @relation(fields: [reporterId], references: [id])
  reporterId Int
  reason     ReportReason
  details    String?
  status     ReportStatus @default(PENDING)
  reviewedBy Int?
  reviewNote String?
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  
  @@index([postId, status])
  @@index([reporterId])
}

model PostMention {
  id           Int      @id @default(autoincrement())
  post         UserPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId       Int
  mentionedUser User    @relation(fields: [userId], references: [id])
  userId       Int
  startIndex   Int      // Position in content where mention starts
  endIndex     Int      // Position where mention ends
  
  @@index([postId])
  @@index([userId])
}

model PostHashtag {
  id       Int      @id @default(autoincrement())
  post     UserPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId   Int
  hashtag  Hashtag  @relation(fields: [hashtagId], references: [id])
  hashtagId Int
  
  @@unique([postId, hashtagId])
  @@index([hashtagId])
}

model Hashtag {
  id        Int           @id @default(autoincrement())
  tag       String        @unique
  usageCount Int          @default(0)
  posts     PostHashtag[]
  createdAt DateTime      @default(now())
  
  @@index([usageCount])
}
