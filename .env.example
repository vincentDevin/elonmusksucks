# ══════════════════════════════════════════════════════════════════════════════
# ElonMuskSucks Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
# IMPORTANT: All variables marked as REQUIRED must be set. The application will
# fail to start if any required variables are missing.
# ══════════════════════════════════════════════════════════════════════════════

# ─── DATABASE (REQUIRED) ─────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elonmusksucks?schema=public

# ─── REDIS (REQUIRED - either REDIS_URL or REDIS_HOST) ──────────────────────
# Option 1: Full Redis URL (recommended for production)
# REDIS_URL=redis://localhost:6379
# REDIS_URL=rediss://user:password@host:port  # Use rediss:// for TLS in production

# Option 2: Redis host and port (development)
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── AUTHENTICATION (REQUIRED) ───────────────────────────────────────────────
# JWT secrets - MUST be at least 32 characters long
# Generate with: openssl rand -base64 32
ACCESS_TOKEN_SECRET=your-super-secure-access-token-secret-here-min-32-chars-change-me
REFRESH_TOKEN_SECRET=your-super-secure-refresh-token-secret-here-min-32-chars-change-me

# bcrypt salt rounds (10-15 recommended, 12 is balanced)
BCRYPT_SALT_ROUNDS=12

# ─── APPLICATION URLS (REQUIRED) ─────────────────────────────────────────────
# Client application URL (React SPA)
CLIENT_APP_URL=http://localhost:3000
BASE_URL_CLIENT=http://localhost:3000

# Server API URL
BASE_URL_SERVER=http://localhost:5000
API_BASE_URL=http://localhost:5000

# Public marketing site URL (SSR)
BASE_URL_PUBLIC=http://localhost:5173

# ─── TIGRIS STORAGE (REQUIRED) ───────────────────────────────────────────────
# S3-compatible object storage for avatars, images, etc.
TIGRIS_S3_ENDPOINT=https://fly.storage.tigris.dev
TIGRIS_S3_BUCKET=your-bucket-name-here
TIGRIS_ACCESS_KEY_ID=tid_your_access_key_here
TIGRIS_SECRET_ACCESS_KEY=tsec_your_secret_key_here

# ─── GAME SERVER (REQUIRED) ──────────────────────────────────────────────────
# Shared secret for pong game server authentication
# CRITICAL: Change this to a unique value - DO NOT use the example value
# CRITICAL: This secret MUST match between main server and pong server
# Generate with: openssl rand -hex 32
GAME_SERVER_SECRET=change-this-to-a-unique-secret-minimum-32-characters-long

# ─── PONG SERVER CONFIGURATION (REQUIRED for pong-server) ───────────────────
# Pong game server port (default: 5001)
# PONG_PORT=5001

# Maximum PVP wager limit (optional, default: 50000 MuskBucks)
# MAX_PVP_WAGER=50000

# API endpoint for pong server to communicate with main server
# IMPORTANT: This is used BY the pong-server to connect TO the main server
# Development: Use localhost
# Production: Use your production API URL
# API_BASE_URL=http://localhost:5000/api

# ─── PUBLIC SITE CONFIGURATION (REQUIRED for public-site) ───────────────────
# Public marketing site port (default: 5173)
# PORT=5173

# API Base URL - Used by SSR server to fetch data
# IMPORTANT: This is used BY the public-site to connect TO the main server
# Development: Use localhost
# Production: Use your production API URL
# API_BASE_URL=http://localhost:5000

# Client App URL - Used for redirects and CORS
# Development: Use localhost
# Production: Use your production client URL
# CLIENT_APP_URL=http://localhost:3000

# Optional: Comma-separated list of allowed CORS origins
# If not set, defaults to CLIENT_APP_URL
# ALLOWED_ORIGINS=https://elonmusksucks.net,https://app.elonmusksucks.net/pong

# ─── EMAIL (OPTIONAL) ────────────────────────────────────────────────────────
# SendGrid API key for email notifications
# SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
# FROM_EMAIL=noreply@elonmusksucks.net

# Skip email verification flow in development (default: false)
SKIP_EMAIL_FLOW=true

# ─── SERVER CONFIGURATION (OPTIONAL) ─────────────────────────────────────────
# Server port (default: 5000)
PORT=5000

# Node environment (development, test, production)
NODE_ENV=development

# ─── WORKER CONCURRENCY (OPTIONAL) ───────────────────────────────────────────
# Adjust based on server resources
# WORKER_PAYOUT_CONCURRENCY=2
# WORKER_PONG_PAYOUT_CONCURRENCY=1
# WORKER_LEADERBOARD_REFRESH_CONCURRENCY=1
# WORKER_LEADERBOARD_EVENT_CONCURRENCY=3
# WORKER_FEED_CONCURRENCY=3
# WORKER_ARTICLE_CONCURRENCY=5

# ─── FEATURE FLAGS (OPTIONAL) ────────────────────────────────────────────────
# Beta cohort percentage (0-100)
# BETA_COHORT_PERCENTAGE=2

# Slow query threshold in milliseconds
# SLOW_QUERY_MS=100

# ══════════════════════════════════════════════════════════════════════════════
# PRODUCTION SECURITY CHECKLIST
# ══════════════════════════════════════════════════════════════════════════════
# Before deploying to production, ensure:
#
# Main Server:
# [ ] All URLs use HTTPS (https://)
# [ ] REDIS_URL uses TLS (rediss://)
# [ ] ACCESS_TOKEN_SECRET is unique and secure (32+ chars)
# [ ] REFRESH_TOKEN_SECRET is unique and secure (32+ chars)
# [ ] GAME_SERVER_SECRET is unique and secure (32+ chars)
# [ ] BCRYPT_SALT_ROUNDS is set appropriately (12-14 recommended)
# [ ] TIGRIS credentials are production credentials
# [ ] SENDGRID_API_KEY is set (unless SKIP_EMAIL_FLOW=true)
# [ ] All secrets are stored securely (e.g., secrets manager, not in git)
#
# Pong Server (if running separately):
# [ ] API_BASE_URL points to production main server (https://)
# [ ] GAME_SERVER_SECRET matches main server exactly
# [ ] CLIENT_APP_URL set correctly for CORS
# [ ] BASE_URL_CLIENT set correctly for CORS
# [ ] MAX_PVP_WAGER set to desired limit
# [ ] NODE_ENV=production
#
# Public Site (SSR marketing site):
# [ ] API_BASE_URL points to production main server (https://)
# [ ] CLIENT_APP_URL points to production client app (https://)
# [ ] ALLOWED_ORIGINS configured with production domains
# [ ] NODE_ENV=production
# [ ] PORT configured correctly (or use default 5173)
# ══════════════════════════════════════════════════════════════════════════════
