{
  "name": "@ems/types",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": false,
  "scripts": {
    "prisma:generate": "prisma generate --schema ../../prisma/schema.prisma",
    "build": "tsc -p tsconfig.build.json"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "destroy": "^1.2.0"
  },
  "devDependencies": {
    "prisma": "^6.10.1",
    "typescript": "^5.9.2"
  },
  "files": [
    "dist",
    "node_modules/.prisma"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  }
}
